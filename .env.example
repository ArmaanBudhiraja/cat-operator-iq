# CAT OperatorIQ Environment Configuration
# Default values run 100% locally with zero external dependencies.

# Database URL: Defaults to local SQLite file in ./data/cat_operator_iq.db
# For PostgreSQL (Docker): postgresql://cat_user:cat_password@localhost:5432/cat_operator_iq
DATABASE_URL=

# Optional OpenAI LLM integration (Assistant operates offline via deterministic RAG if empty)
OPENAI_API_KEY=

# Optional Live Weather API key (System runs on realistic synthetic weather data if empty)
WEATHER_API_KEY=

# Frontend API base URL (defaults to proxy /api)
VITE_API_URL=http://localhost:8000

# Synthetic Data Generation Seed
RANDOM_SEED=42
